{
  "id": "builder",
  "name": "Builder",
  "version": "0.1.0",
  "description": "A pack for making things with Claude: your own plugins, and projects planned as tasks and concepts.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "construction",
  "kind": "app",
  "dependencies": {
    "claude": "^0.3",
    "devtools": "^0.1",
    "pipeline": "^0.4",
    "concepts": "^0.2"
  },
  "sessions": [
    {
      "id": "make-plugin",
      "name": "Make a plugin",
      "icon": "extension",
      "description": "Claude, with a first message ready, makes a small plugin; My plugins beside it shows its history and versions.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.55,
            0.45
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "claude",
                  "panel": "threads",
                  "params": {
                    "new": true,
                    "target": "plugin",
                    "plugin": "new",
                    "prompt": "Make me a small layr plugin: a daily checklist panel whose items are kept in the plugin's own data, with a box to add an item and a tick to check one off. Keep it simple, then tell me how to open it."
                  }
                }
              ]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "devtools",
                  "panel": "main"
                }
              ]
            }
          ]
        },
        "floating": []
      }
    },
    {
      "id": "plan",
      "name": "Plan a project",
      "icon": "account_tree",
      "description": "The pipeline's task board next to the concept map: plan the ideas, then run them as Claude tasks.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.5,
            0.5
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "pipeline",
                  "panel": "board"
                }
              ]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "concepts",
                  "panel": "map"
                }
              ]
            }
          ]
        },
        "floating": []
      }
    }
  ]
}
